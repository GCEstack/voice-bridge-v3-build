{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Participant Identity Contract",
  "description": "Canonical contract for participant identity in the EdgeCrew Math Engine.",
  "type": "object",
  "properties": {
    "participant_id": {
      "description": "Unique identifier for the participant.",
      "type": "string"
    },
    "role": {
      "description": "Role of the participant (player/coach/competitor).",
      "type": "string",
      "enum": ["player", "coach", "competitor"]
    },
    "team": {
      "description": "Team identifier.",
      "type": "string"
    },
    "reliability": {
      "description": "Reliability score (0.0 to 1.0).",
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "uncertainty": {
      "description": "Uncertainty score (0.0 to 1.0).",
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "provenance": {
      "description": "Provenance metadata for replayability.",
      "type": "object",
      "properties": {
        "source": {
          "description": "Source of the participant data.",
          "type": "string"
        },
        "timestamp": {
          "description": "Timestamp of data ingestion (ISO 8601).",
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "description": "Version of the data schema.",
          "type": "string"
        }
      },
      "required": ["source", "timestamp", "version"]
    }
  },
  "required": [
    "participant_id",
    "role",
    "team",
    "reliability",
    "uncertainty",
    "provenance"
  ]
}