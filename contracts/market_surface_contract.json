{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Market Surface Contract",
  "description": "Contract for market surface data in the EdgeCrew Math Engine.",
  "type": "object",
  "properties": {
    "event_id": {
      "description": "Unique identifier for the event.",
      "type": "string"
    },
    "fair_state": {
      "description": "Estimated fair state of the market.",
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "market_comparison": {
      "description": "Comparison of fair state to market odds.",
      "type": "object",
      "properties": {
        "market_odds": {
          "description": "Current market odds.",
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "edge": {
          "description": "Edge identified (positive/negative).",
          "type": "number"
        },
        "ev": {
          "description": "Expected value calculation.",
          "type": "number"
        }
      },
      "required": ["market_odds", "edge", "ev"]
    },
    "kalshi_comparison": {
      "description": "Comparison to Kalshi or other prediction markets.",
      "type": "object",
      "properties": {
        "kalshi_odds": {
          "description": "Kalshi market odds.",
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "edge": {
          "description": "Edge identified (positive/negative).",
          "type": "number"
        },
        "ev": {
          "description": "Expected value calculation.",
          "type": "number"
        }
      },
      "required": ["kalshi_odds", "edge", "ev"]
    },
    "confidence": {
      "description": "Confidence score (0.0 to 1.0).",
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "WHY": {
      "description": "Explanation for the edge or confidence calculation.",
      "type": "string"
    },
    "coherence_certificate": {
      "description": "Certificate of coherence for the market surface.",
      "type": "object",
      "properties": {
        "coherent": {
          "description": "Flag indicating coherence.",
          "type": "boolean"
        },
        "inconsistencies": {
          "description": "List of inconsistencies, if any.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timestamp": {
          "description": "Timestamp of certification (ISO 8601).",
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["coherent", "timestamp"]
    },
    "provenance": {
      "description": "Provenance metadata for replayability.",
      "type": "object",
      "properties": {
        "source": {
          "description": "Source of the market data.",
          "type": "string"
        },
        "timestamp": {
          "description": "Timestamp of data ingestion (ISO 8601).",
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "description": "Version of the data schema.",
          "type": "string"
        }
      },
      "required": ["source", "timestamp", "version"]
    }
  },
  "required": [
    "event_id",
    "fair_state",
    "market_comparison",
    "confidence",
    "WHY",
    "coherence_certificate",
    "provenance"
  ]
}